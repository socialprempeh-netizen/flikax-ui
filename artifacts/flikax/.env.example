# Copy this file to .env.local and fill in real values. .env.local is
# gitignored -- never commit real secrets. See the root README.md's
# "Environment variables" section for the long-form explanation of each one.

# Public. From Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build absolute URLs in robots.txt/sitemap.xml. Falls back to
# http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=https://flikax.com

# Server-only. Required for "Delete my account permanently" in Settings.
# Get it from Supabase dashboard -> Project Settings -> API -> service_role key.
# NEVER expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Master switch for Paystack/Flutterwave + the Featured-listing paid tier.
# Payments are built end-to-end but must stay OFF until the business is
# registered and both providers are verified -- see BUGS_AND_TODO.md.
PAYMENTS_ENABLED=false

# Server-only. From your Paystack dashboard -> Settings -> API Keys & Webhooks.
PAYSTACK_SECRET_KEY=

# Server-only. From your Flutterwave dashboard -> Settings -> API Keys.
FLUTTERWAVE_SECRET_KEY=
# Server-only. Flutterwave dashboard -> Settings -> Webhooks -> "Secret hash"
# (your own arbitrary string, not provider-generated).
FLUTTERWAVE_SECRET_HASH=
